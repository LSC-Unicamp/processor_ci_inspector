SIM ?= verilator
TOPLEVEL_LANG ?= verilog
export TWO_MEMORIES = True
export OLLAMA = False
COMPILE_ARGS ?= --language 1800-2017 -DSIMULATION -Wno-fatal -Wno-lint --public-flat-rw --trace --trace-structs --trace-underscore
VERILOG_INCLUDE_DIRS += RV-Bench/cores/RS5
VERILOG_INCLUDE_DIRS += RV-Bench/cores/RS5/rtl
VERILOG_INCLUDE_DIRS += RV-Bench/cores/RS5/RingBuffer/rtl
VERILOG_SOURCES += RV-Bench/cores/RS5/rtl/RS5_pkg.sv
