SIM ?= verilator
TOPLEVEL_LANG ?= verilog
export TWO_MEMORIES = True
export OLLAMA = False
COMPILE_ARGS ?= --language 1800-2017 -DSIMULATION -Wno-fatal -Wno-lint --public-flat-rw --trace --trace-structs --trace-underscore
VERILOG_INCLUDE_DIRS += RV-Bench/cores/tinyriscv
VERILOG_INCLUDE_DIRS += RV-Bench/cores/tinyriscv/rtl/core
VERILOG_INCLUDE_DIRS += RV-Bench/cores/tinyriscv/rtl/utils
